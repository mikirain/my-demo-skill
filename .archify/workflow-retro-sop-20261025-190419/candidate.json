  "cards": [
    {
      "dot": "emerald",
      "title": "何时该触发",
      "items": [
        "已出结果（中标 / 失标）才复盘：为什么赢、按 A/B/C 定级、经验入库、出报告、到期检查",
        "未投标 / 未开标 / 只想聊方法论，或要报价、标书、对比矩阵 → 不是本 skill",
        "材料不足时按 S1 追问；缺必需材料就中止，不编造"
      ]
    },
    {
      "dot": "amber",
      "title": "SOP 细则（图上未展开）",
      "items": [
        "S1 命令：init_case 建工作区 → check_inputs 出 gap.json；退出码 2 即停",
        "S4 交付门禁加 --strict；WARNING 不拦交付，但要在报告告警区解释",
        "S4.5 退出码 2 = 有到期项（待办，不是错误）；写进报告待补清单",
        "S5 角色：engineer / bidManager / knowledge 全量，commercial 隐技术细项，legal 突出履约，exec 脱敏，viewer 只读，admin 拒绝",
        "S5 输出目录 docs/output/retro/<retroId>/，文件名 中标复盘-<项目名>-<复盘日期>[-角色].md",
        "S6 引用确定后回写 references[]，四项留痕"
      ]
    },
    {
      "dot": "rose",
      "title": "红线（违反即返工）",
      "items": [
        "BR-11 无来源不入库；BR-12 C 级不作结论载体",
        "BR-13 无评分表最高 B，score/maxScore 为 null",
        "BR-14 履约 missed 立即降级并留痕",
        "BR-18 不自动定级、不自动入库，一律 draft",
        "BR-19 缺数据标 pending，禁止编造"
      ]
    },
    {
      "dot": "cyan",
      "title": "交付前自检",
      "items": [
        "A 级能指到评分分项 / 评标反馈 / 客户书面认可，且 reviewState=verified",
        "有评分表的项目，每条因素都能答「这条 8 分是哪一页」",
        "缺失值全是 — 或 null，没有 0 填充，竞对未知未计入优势",
        "每条经验齐 12 字段，scope 写清「适用于 / 不适用于」",
        "C 级都有验证计划与到期日，且不在任何结论段"
      ]
    }
  ]
